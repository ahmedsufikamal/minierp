# Database (required)
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/minierp?schema=public"

# Auth (required; min 32 characters)
JWT_SECRET="your-at-least-32-character-secret-use-openssl-rand-base64-32"
IAM_V2_ENABLED=1
IAM_PROVIDER=local
IAM_TOKEN_HASH_SECRET="replace-with-32-plus-char-secret"
IAM_ENCRYPTION_SECRET="replace-with-32-plus-char-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_COOKIE_DOMAIN=""
IAM_REQUIRE_SAME_ORIGIN=1

# Migration bridge flags (default rollout: 30 days)
IAM_LEGACY_FALLBACK_ENABLED=1
IAM_DUAL_WRITE_LEGACY_SESSION=1
IAM_LEGACY_FALLBACK_SUNSET_DAYS=30
IAM_INVITE_SIGNUP_BRIDGE_ENABLED=1
IAM_INVENTORY_PERMISSION_SYNC_ENABLED=1

# MFA rate limiting
IAM_MFA_ENROLL_RATE_LIMIT_MAX_ATTEMPTS=6
IAM_MFA_ENROLL_RATE_LIMIT_WINDOW_SECONDS=60
IAM_MFA_ENROLL_IP_RATE_LIMIT_MAX_ATTEMPTS=20
IAM_MFA_ENROLL_IP_RATE_LIMIT_WINDOW_SECONDS=60
IAM_MFA_VERIFY_RATE_LIMIT_MAX_ATTEMPTS=10
IAM_MFA_VERIFY_RATE_LIMIT_WINDOW_SECONDS=60
IAM_MFA_VERIFY_IP_RATE_LIMIT_MAX_ATTEMPTS=40
IAM_MFA_VERIFY_IP_RATE_LIMIT_WINDOW_SECONDS=60

# Inventory storage signing (required in production, >=32 chars)
INVENTORY_STORAGE_SIGNING_SECRET="replace-with-32-plus-char-secret"

# Optional: REST API (for /api/v1/*)
# API_KEY="your-api-key"
# API_ORG_ID="org-id-for-api-key-scope"
# API_KEY_QUERY_FALLBACK_ENABLED=1
# API_KEY_QUERY_SUNSET_DATE="2026-03-14"
# API_ALLOW_DEFAULT_ORG_FALLBACK=0
