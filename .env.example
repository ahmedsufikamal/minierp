# Database (required)
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/minierp?schema=public"

# Auth (required; min 32 characters)
JWT_SECRET="your-at-least-32-character-secret-use-openssl-rand-base64-32"
IAM_V2_ENABLED=1
IAM_PROVIDER=local
IAM_TOKEN_HASH_SECRET="replace-with-32-plus-char-secret"
IAM_ENCRYPTION_SECRET="replace-with-32-plus-char-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_COOKIE_DOMAIN=""
IAM_REQUIRE_SAME_ORIGIN=1

# Migration bridge flags (default rollout: 30 days)
IAM_LEGACY_FALLBACK_ENABLED=1
IAM_DUAL_WRITE_LEGACY_SESSION=1
IAM_LEGACY_FALLBACK_SUNSET_DAYS=30
IAM_INVITE_SIGNUP_BRIDGE_ENABLED=1
IAM_INVENTORY_PERMISSION_SYNC_ENABLED=1
IAM_MASTER_ADMIN_ENFORCEMENT=1
IAM_PLATFORM_ROLE_MANAGEMENT=1
IAM_SELF_SERVE_ORG_CREATION=0

# IAM notification and queue runtime
IAM_NOTIFICATION_PROVIDER=http
IAM_QUEUE_PROVIDER=inline
# Set to bullmq in production with Redis
# IAM_QUEUE_PROVIDER=bullmq
# REDIS_URL=redis://127.0.0.1:6379/0
# IAM_QUEUE_NAME=iam-notifications
# IAM_QUEUE_CONCURRENCY=5
# IAM_WORKER_VERBOSE=0

# MFA rate limiting
IAM_MFA_ENROLL_RATE_LIMIT_MAX_ATTEMPTS=6
IAM_MFA_ENROLL_RATE_LIMIT_WINDOW_SECONDS=60
IAM_MFA_ENROLL_IP_RATE_LIMIT_MAX_ATTEMPTS=20
IAM_MFA_ENROLL_IP_RATE_LIMIT_WINDOW_SECONDS=60
IAM_MFA_VERIFY_RATE_LIMIT_MAX_ATTEMPTS=10
IAM_MFA_VERIFY_RATE_LIMIT_WINDOW_SECONDS=60
IAM_MFA_VERIFY_IP_RATE_LIMIT_MAX_ATTEMPTS=40
IAM_MFA_VERIFY_IP_RATE_LIMIT_WINDOW_SECONDS=60
IAM_MFA_RECOVERY_RATE_LIMIT_MAX_ATTEMPTS=6
IAM_MFA_RECOVERY_RATE_LIMIT_WINDOW_SECONDS=60
IAM_MFA_RECOVERY_IP_RATE_LIMIT_MAX_ATTEMPTS=20
IAM_MFA_RECOVERY_IP_RATE_LIMIT_WINDOW_SECONDS=60

# Account verification controls
IAM_EMAIL_CHANGE_OTP_TTL_SECONDS=600
IAM_EMAIL_CHANGE_OTP_MAX_ATTEMPTS=6
IAM_EMAIL_CHANGE_OTP_WINDOW_SECONDS=60
IAM_EMAIL_CHANGE_OTP_IP_MAX_ATTEMPTS=20
IAM_EMAIL_CHANGE_OTP_IP_WINDOW_SECONDS=60
IAM_PHONE_VERIFY_OTP_MAX_ATTEMPTS=6
IAM_PHONE_VERIFY_OTP_WINDOW_SECONDS=60
IAM_PHONE_VERIFY_OTP_IP_MAX_ATTEMPTS=20
IAM_PHONE_VERIFY_OTP_IP_WINDOW_SECONDS=60
IAM_PHONE_VERIFY_CONFIRM_MAX_ATTEMPTS=10
IAM_PHONE_VERIFY_CONFIRM_WINDOW_SECONDS=60
IAM_PHONE_VERIFY_CONFIRM_IP_MAX_ATTEMPTS=25
IAM_PHONE_VERIFY_CONFIRM_IP_WINDOW_SECONDS=60
IAM_PASSWORD_RESET_FORCED_MAX_ATTEMPTS=8
IAM_PASSWORD_RESET_FORCED_WINDOW_SECONDS=60
IAM_PASSWORD_RESET_FORCED_IP_MAX_ATTEMPTS=20
IAM_PASSWORD_RESET_FORCED_IP_WINDOW_SECONDS=60

# Domain verification token TTL (seconds)
IAM_DOMAIN_VERIFY_TOKEN_TTL_SECONDS=604800

# Inventory storage signing (required in production, >=32 chars)
INVENTORY_STORAGE_SIGNING_SECRET="replace-with-32-plus-char-secret"

# Automation webhook runtime (required signing secret in production, >=32 chars)
AUTOMATION_WEBHOOK_ALLOWLIST="http://localhost:3000"
AUTOMATION_WEBHOOK_TIMEOUT_MS=5000
AUTOMATION_WEBHOOK_MAX_ATTEMPTS=3
AUTOMATION_WEBHOOK_SIGNING_SECRET="replace-with-32-plus-char-secret"

# Optional bot protection
# IAM_TURNSTILE_ENABLED=1
# TURNSTILE_SECRET_KEY=""
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Optional: REST API (for /api/v1/*)
# API_KEY="your-api-key"
# API_ORG_ID="org-id-for-api-key-scope"
# API_KEY_QUERY_FALLBACK_ENABLED=1
# API_KEY_QUERY_SUNSET_DATE="2026-03-14"
# API_ALLOW_DEFAULT_ORG_FALLBACK=0

# Optional: Rust strangler API base URL (used by /api/rust/* proxy adapter)
# RUST_API_BASE_URL="http://127.0.0.1:4000"

# Optional: inventory item slice strangler switch
INVENTORY_ITEMS_RUST_ENABLED=0
# Required when INVENTORY_ITEMS_RUST_ENABLED=1 (>=32 chars)
RUST_TRUSTED_PROXY_SECRET="replace-with-32-plus-char-secret"
