  onHand       Int                         @default(0)
  reserved     Int                         @default(0)
  incoming     Int                         @default(0)
  outgoing     Int                         @default(0)
  avgCostMinor Int?
  updatedAt    DateTime                    @updatedAt

  @@unique([companyId, itemId, warehouseId, locationId])
  @@index([companyId, warehouseId, locationId])
  @@index([companyId, itemId])
}

model InventoryReorderRule {
  id                String                      @id @default(cuid())
  companyId         String                      @map("orgId")
  itemId            String
  item              Product                     @relation(fields: [itemId], references: [id], onDelete: Cascade)
