  @@unique([companyId, number])
}

enum PaymentType {
  INBOUND
  OUTBOUND
}

enum PaymentMethod {
  CASH
  BANK
  CARD
  OTHER
}

enum PaymentEntryStatus {
  DRAFT
  SUBMITTED
  POSTED
  CANCELLED
}

enum SupplierPaymentStatus {
  DRAFT
  SUBMITTED
  POSTED
  CANCELLED
}

model Payment {
  id          String        @id @default(cuid())
  companyId   String        @map("orgId")
  type        PaymentType
  amountCents Int
  date        DateTime      @default(now())
  reference   String?
  method      PaymentMethod @default(CASH)
  invoiceId   String?
  invoice     SalesInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  billId      String?
  bill        PurchaseBill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([companyId, date])
  @@index([invoiceId])
  @@index([billId])
}

