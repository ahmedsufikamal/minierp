  targetCurrency      String                @default("USD")
  exchangeRate        Decimal?              @db.Decimal(18, 6)
  paidFromAccountId   String?
  paidFromAccount     Account?              @relation("PaymentEntryPaidFrom", fields: [paidFromAccountId], references: [id], onDelete: SetNull)
  paidToAccountId     String?
  paidToAccount       Account?              @relation("PaymentEntryPaidTo", fields: [paidToAccountId], references: [id], onDelete: SetNull)
