generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum BillStatus {
  DRAFT
  RECEIVED
  PAID
  VOID
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InventoryMoveType {
  IN
  OUT
  ADJUST
}

enum StockLedgerTxnType {
  OPENING
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  REVERSAL
  TRANSFER
}

enum InventorySnapshotMode {
  OPENING_ONLY
  HISTORY_APPROX
}

enum InventorySnapshotStatus {
  PENDING
  VALIDATED
  IMPORTED
  FAILED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum InventoryCustomFieldEntityType {
  ITEM
  WAREHOUSE
  LOCATION
  DOCUMENT
  DOCUMENT_LINE
}

enum InventoryCustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  CURRENCY
  BOOLEAN
  DATE
  DATETIME
  SELECT
  MULTISELECT
  USER
  REFERENCE
  JSON
  BARCODE
}

enum InventoryDocumentType {
  ADJUSTMENT
  TRANSFER
  RECEIPT
  ISSUE
  COUNT
}

enum InventoryDocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  POSTED
}

enum InventoryPresetScope {
  USER
  ROLE
  COMPANY
}

enum InventoryAttachmentEntityType {
  ITEM
  DOCUMENT
}

enum InventoryImportJobStatus {
  PENDING
  VALIDATED
  PROCESSING
  COMPLETED
  FAILED
}

enum InventoryExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum IamTenantStatus {
  ACTIVE
  DISABLED
  PENDING_DELETION
}

enum IamPlatformRole {
  SUPER_ADMIN
  SUPPORT
  NONE
}

enum IamUserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum IamMembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum IamAuthMethod {
  PASSWORD
  MAGIC_LINK
  OAUTH_GOOGLE
  OAUTH_MICROSOFT
  OTP_EMAIL
  OTP_SMS
}

enum IamMfaPolicyMode {
  OPTIONAL
  REQUIRED_FOR_ADMINS
  REQUIRED_FOR_ALL
}

enum IamDomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum IamOtpChannel {
  EMAIL
  SMS
}

enum IamSessionRevokeReason {
  USER_LOGOUT
  USER_REVOKE_ALL
  ADMIN_REVOKE
  SECURITY_EVENT
}

enum IamMfaFactorType {
  TOTP
  OTP_EMAIL
  OTP_SMS
}

enum IamAutoJoinRuleType {
  VERIFIED_DOMAIN
  EMAIL_ALLOWLIST
  MANUAL_APPROVAL
}

enum IamAuditAction {
  AUTH_LOGIN
  AUTH_LOGIN_FAILED
  AUTH_LOGOUT
  AUTH_SIGNUP
  MFA_ENROLLED
  MFA_CHALLENGE_VERIFIED
  OTP_SENT
  OTP_VERIFIED
  MAGIC_LINK_SENT
  MAGIC_LINK_VERIFIED
  SESSION_REVOKED
  SESSION_REVOKE_ALL
  INVITE_SENT
  INVITE_ACCEPTED
  ROLE_CHANGED
  POLICY_UPDATED
  IMPERSONATION_STARTED
  IMPERSONATION_ENDED
  TENANT_DISABLED
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  passwordHash    String
  name            String
  role            String          @default("USER")
  companyId       String          @default("default-org") @map("orgId")
  phone           String?
  avatarUrl       String?
  platformRole    IamPlatformRole @default(NONE)
  status          IamUserStatus   @default(ACTIVE)
  activeCompanyId String?         @map("activeOrgId")
  sessionVersion  Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  activeCompany       Company?                 @relation("ActiveCompany", fields: [activeCompanyId], references: [id], onDelete: SetNull)
  memberships         CompanyMembership[]
  iamSessions         IamSession[]
  iamMfaFactors       IamMfaFactor[]
  iamRecoveryCodes    IamRecoveryCode[]
  iamOtpChallenges    IamOtpChallenge[]
  iamMagicLinkTokens  IamMagicLinkToken[]
  iamOAuthAccounts    IamOAuthAccount[]
  iamInvitesCreated   IamInvitation[]          @relation("IamInviteCreator")
  iamAuditActorEvents IamAuditLog[]            @relation("IamAuditActor")
  iamLoginAttempts    IamLoginAttempt[]
  iamImpersonations   IamImpersonationSession[] @relation("IamImpersonationActor")
  iamImpersonatedBy   IamImpersonationSession[] @relation("IamImpersonationTarget")
}

model Customer {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices      SalesInvoice[]
  quotes        Quote[]
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  tasks         Task[]
}

model Vendor {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills          PurchaseBill[]
  purchaseOrders PurchaseOrder[]
  reorderRules   InventoryReorderRule[]
}

model Brand {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Category {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subCategories SubCategory[]
  products      Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

model SubCategory {
  id         String   @id @default(cuid())
  companyId  String   @map("orgId")
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products Product[]

  @@unique([companyId, categoryId, name])
  @@index([companyId])
}

model StockLocation {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  code      String // e.g., A6, Z1
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances StockBalance[]
  ledger   StockLedger[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Product {
  id                String       @id @default(cuid())
  companyId         String       @map("orgId")
  brandId           String
  brand             Brand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  sku               String
  normalizedSku     String
  title             String?
  name              String
  description       String?
  ratingType        String? // Rating (kW)/ Type
  coo               String? // Country of Origin
  categoryId        String?
  category          Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryId     String?
  subCategory       SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  uom               String       @default("pcs")
  priceCents        Int          @default(0)
  unitCostMinor     Int?         @default(0)
  lowStockThreshold Int? // optional: warn when stock below this
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  invoiceLines             SalesInvoiceLine[]
  billLines                PurchaseBillLine[]
  quoteLines               QuoteLine[]
  purchaseOrderLines       PurchaseOrderLine[]
  moves                    InventoryMove[]
  balances                 StockBalance[]
  ledger                   StockLedger[]
  inventoryItemIdentifiers InventoryItemIdentifier[]
  inventoryDocumentLines   InventoryDocumentLine[]
  inventoryLedgerEntries   InventoryLedgerEntry[]
  inventoryStockBalances   InventoryStockBalance[]
  inventoryReorderRules    InventoryReorderRule[]

  @@unique([companyId, brandId, normalizedSku])
  @@index([companyId, brandId])
  @@index([companyId, normalizedSku])
}

model SalesInvoice {
  id          String        @id @default(cuid())
  companyId   String        @map("orgId")
  number      String
  status      InvoiceStatus @default(DRAFT)
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceDate DateTime      @default(now())
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines              SalesInvoiceLine[]
  convertedFromQuote Quote?
  payments           Payment[]

  @@unique([companyId, number])
}

model Quote {
  id                   String        @id @default(cuid())
  companyId            String        @map("orgId")
  number               String
  status               QuoteStatus   @default(DRAFT)
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quoteDate            DateTime      @default(now())
  validUntil           DateTime?
  notes                String?
  convertedToInvoiceId String?       @unique
  convertedToInvoice   SalesInvoice? @relation(fields: [convertedToInvoiceId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  lines QuoteLine[]

  @@unique([companyId, number])
}

model QuoteLine {
  id             String   @id @default(cuid())
  quoteId        String
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description    String
  qty            Int
  unitPriceCents Int
}

model SalesInvoiceLine {
  id             String       @id @default(cuid())
  invoiceId      String
  invoice        SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  description    String
  qty            Int
  unitPriceCents Int
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  companyId    String              @map("orgId")
  number       String
  status       PurchaseOrderStatus @default(DRAFT)
  vendorId     String
  vendor       Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  lines PurchaseOrderLine[]

  @@unique([companyId, number])
}

model PurchaseOrderLine {
  id             String        @id @default(cuid())
  orderId        String
  order          PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  description    String
  qtyOrdered     Int
  qtyReceived    Int           @default(0)
  unitPriceCents Int
}

model PurchaseBill {
  id        String     @id @default(cuid())
  companyId String     @map("orgId")
  number    String
  status    BillStatus @default(DRAFT)
  vendorId  String
  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  billDate  DateTime   @default(now())
  dueDate   DateTime?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  lines    PurchaseBillLine[]
  payments Payment[]

  @@unique([companyId, number])
}

enum PaymentType {
  INBOUND
  OUTBOUND
}

enum PaymentMethod {
  CASH
  BANK
  CARD
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  companyId   String        @map("orgId")
  type        PaymentType
  amountCents Int
  date        DateTime      @default(now())
  reference   String?
  method      PaymentMethod @default(CASH)
  invoiceId   String?
  invoice     SalesInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  billId      String?
  bill        PurchaseBill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([companyId, date])
  @@index([invoiceId])
  @@index([billId])
}

model OrgSetting {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  key       String
  value     String // store JSON for complex values
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String   @map("orgId")
  userId     String
  action     String // CREATED, UPDATED, DELETED
  entityType String
  entityId   String?
  oldValues  String? // JSON
  newValues  String? // JSON
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entityType])
}

model PurchaseBillLine {
  id             String       @id @default(cuid())
  billId         String
  bill           PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  description    String
  qty            Int
  unitPriceCents Int
}

model InventoryMove {
  id        String            @id @default(cuid())
  companyId String            @map("orgId")
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type      InventoryMoveType
  qty       Int
  note      String?
  createdAt DateTime          @default(now())
}

model Account {
  id        String      @id @default(cuid())
  companyId String      @map("orgId")
  code      String
  name      String
  type      AccountType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  lines JournalLine[]

  @@unique([companyId, code])
}

model JournalEntry {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  date      DateTime @default(now())
  memo      String?
  createdAt DateTime @default(now())

  lines JournalLine[]
}

model JournalLine {
  id          String       @id @default(cuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debitCents  Int          @default(0)
  creditCents Int          @default(0)
}

// CRM Models

model Contact {
  id         String   @id @default(cuid())
  companyId  String   @map("orgId")
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String?
  email      String?
  phone      String?
  jobTitle   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum OpportunityStage {
  NEW
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Opportunity {
  id          String           @id @default(cuid())
  companyId   String           @map("orgId")
  title       String
  valueCents  Int              @default(0)
  stage       OpportunityStage @default(NEW)
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  closeDate   DateTime?
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  activities Activity[]
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

model Activity {
  id            String       @id @default(cuid())
  companyId     String       @map("orgId")
  type          ActivityType
  subject       String
  description   String?
  date          DateTime     @default(now())
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String       @id @default(cuid())
  companyId   String       @map("orgId")
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Inventory Models

model InventorySnapshot {
  id             String                  @id @default(cuid())
  companyId      String                  @map("orgId")
  importedAt     DateTime                @default(now())
  sourceFileName String
  sourceFileHash String
  mode           InventorySnapshotMode
  status         InventorySnapshotStatus
  warnings       Json?
  errors         Json?
  createdBy      String?
  createdAt      DateTime                @default(now())

  ledger StockLedger[]

  @@unique([companyId, sourceFileHash])
  @@index([companyId, importedAt])
  @@index([companyId, status])
}

model StockBalance {
  id           String         @id @default(cuid())
  companyId    String         @map("orgId")
  itemId       String
  item         Product        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId   String? // null = overall balance
  location     StockLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  qtyOnHand    Int            @default(0)
  avgCostMinor Int?
  updatedAt    DateTime       @updatedAt

  @@unique([companyId, itemId, locationId])
  @@index([companyId, itemId])
  @@index([companyId, locationId])
}

model StockLedger {
  id             String             @id @default(cuid())
  companyId      String             @map("orgId")
  itemId         String
  item           Product            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId     String? // null = overall
  location       StockLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  txnType        StockLedgerTxnType
  qtyDelta       Int // positive for IN, negative for OUT
  unitCostMinor  Int?
  totalCostMinor Int?
  refInvoice     String?
  refChalan      String?
  notes          String?
  meta           Json?
  txnDate        DateTime           @default(now()) @db.Date
  snapshotId     String? // link to import batch
  snapshot       InventorySnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  createdBy      String? // userId if available
  createdAt      DateTime           @default(now())

  @@index([companyId, itemId, txnDate])
  @@index([companyId, locationId])
  @@index([companyId, snapshotId])
  @@index([companyId, txnDate])
}

// Multi-company support for explicit company membership / active context selection.
model Company {
  id                     String                      @id @default(cuid())
  name                   String
  slug                   String?                     @unique
  isActive               Boolean                     @default(true)
  status                 IamTenantStatus             @default(ACTIVE)
  logoUrl                String?
  primaryColor           String?
  accentColor            String?
  fontFamily             String?
  cssVars                Json?
  customCss              String?
  primaryDomain          String?                     @unique
  allowedDomains         Json?
  domainVerificationStatus IamDomainVerificationStatus @default(PENDING)
  allowedAuthMethods     Json?
  mfaPolicy              Json?
  sessionPolicy          Json?
  botProtectionPolicy    Json?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  memberships             CompanyMembership[]
  activeUsers             User[]                     @relation("ActiveCompany")
  iamRoles                IamRole[]
  iamInvites              IamInvitation[]
  iamAutoJoinRules        IamAutoJoinRule[]
  iamSessions             IamSession[]
  iamOtpChallenges        IamOtpChallenge[]
  iamAuditLogs            IamAuditLog[]
  iamLoginAttempts        IamLoginAttempt[]
  iamImpersonationTargets IamImpersonationSession[] @relation("IamImpersonationCompany")
}

model CompanyMembership {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role       String
  roleId     String?
  roleRef    IamRole?            @relation(fields: [roleId], references: [id], onDelete: SetNull)
  status     IamMembershipStatus @default(ACTIVE)
  isDefault  Boolean             @default(false)
  joinedAt   DateTime?
  lastActiveAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([userId, companyId])
  @@index([companyId, roleId])
  @@index([companyId, role])
}

model InventoryCompanySetting {
  id                    String   @id @default(cuid())
  companyId             String   @unique @map("orgId")
  trackByLocation       Boolean  @default(false)
  preventNegativeStock  Boolean  @default(true)
  allowNegativeOverride Boolean  @default(false)
  costingMethod         String   @default("AVG")
  baseCurrency          String   @default("BDT")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model InventoryWarehouse {
  id          String   @id @default(cuid())
  companyId   String   @map("orgId")
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locations                InventoryWarehouseLocation[]
  sourceDocuments          InventoryDocument[]          @relation("InventoryDocumentSourceWarehouse")
  destinationDocuments     InventoryDocument[]          @relation("InventoryDocumentDestinationWarehouse")
  sourceDocumentLines      InventoryDocumentLine[]      @relation("InventoryDocumentLineSourceWarehouse")
  destinationDocumentLines InventoryDocumentLine[]      @relation("InventoryDocumentLineDestinationWarehouse")
  ledgerEntries            InventoryLedgerEntry[]
  balances                 InventoryStockBalance[]
  reorderRules             InventoryReorderRule[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model InventoryWarehouseLocation {
  id          String                       @id @default(cuid())
  companyId   String                       @map("orgId")
  warehouseId String
  warehouse   InventoryWarehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      InventoryWarehouseLocation?  @relation("WarehouseLocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    InventoryWarehouseLocation[] @relation("WarehouseLocationTree")
  code        String
  name        String
  path        String?
  isActive    Boolean                      @default(true)
  metadata    Json?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  sourceDocuments          InventoryDocument[]     @relation("InventoryDocumentSourceLocation")
  destinationDocuments     InventoryDocument[]     @relation("InventoryDocumentDestinationLocation")
  sourceDocumentLines      InventoryDocumentLine[] @relation("InventoryDocumentLineSourceLocation")
  destinationDocumentLines InventoryDocumentLine[] @relation("InventoryDocumentLineDestinationLocation")
  ledgerEntries            InventoryLedgerEntry[]
  balances                 InventoryStockBalance[]
  reorderRules             InventoryReorderRule[]

  @@unique([companyId, warehouseId, code])
  @@index([companyId, warehouseId, parentId])
}

model InventoryItemIdentifier {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  itemId    String
  item      Product  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind      String
  value     String
  isPrimary Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, value])
  @@index([companyId, itemId, kind])
}

model InventoryCustomFieldDefinition {
  id              String                         @id @default(cuid())
  companyId       String                         @map("orgId")
  entityType      InventoryCustomFieldEntityType
  key             String
  label           String
  description     String?
  fieldType       InventoryCustomFieldType
  required        Boolean                        @default(false)
  unique          Boolean                        @default(false)
  indexed         Boolean                        @default(false)
  showInList      Boolean                        @default(false)
  config          Json?
  defaultValue    Json?
  validationRules Json?
  visibilityRoles Json?
  computedExpr    String?
  isActive        Boolean                        @default(true)
  sortOrder       Int                            @default(0)
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  values InventoryCustomFieldValue[]

  @@unique([companyId, entityType, key])
  @@index([companyId, entityType, isActive])
}

model InventoryCustomFieldValue {
  id                String                         @id @default(cuid())
  companyId         String                         @map("orgId")
  entityType        InventoryCustomFieldEntityType
  entityId          String
  fieldDefinitionId String
  fieldDefinition   InventoryCustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  value             Json
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  @@unique([companyId, entityType, entityId, fieldDefinitionId])
  @@index([companyId, entityType, entityId])
  @@index([companyId, fieldDefinitionId])
}

model InventoryViewPreset {
  id          String               @id @default(cuid())
  companyId   String               @map("orgId")
