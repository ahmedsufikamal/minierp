  accountingPeriod   AccountingPeriod? @relation(fields: [accountingPeriodId], references: [id], onDelete: SetNull)
  debitCents         Int               @default(0)
  creditCents        Int               @default(0)
  currency           String            @default("USD")
  voucherType        String?
  voucherId          String?
  remarks            String?
  metadata           Json?
  createdBy          String?
  createdAt          DateTime          @default(now())

  @@index([tenantId, companyId, postingDate])
  @@index([tenantId, companyId, accountId, postingDate])
  @@index([tenantId, companyId, voucherType, voucherId])
  @@index([journalEntryId])
}

