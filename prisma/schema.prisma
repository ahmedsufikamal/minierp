generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum BillStatus {
  DRAFT
  RECEIVED
  PAID
  VOID
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InventoryMoveType {
  IN
  OUT
  ADJUST
}

enum StockLedgerTxnType {
  OPENING
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  REVERSAL
  TRANSFER
}

enum InventorySnapshotMode {
  OPENING_ONLY
  HISTORY_APPROX
}

enum InventorySnapshotStatus {
  PENDING
  VALIDATED
  IMPORTED
  FAILED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("USER")
  companyId    String   @default("default-org") @map("orgId")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices    SalesInvoice[]
  quotes     Quote[]
  contacts    Contact[]
  opportunities Opportunity[]
  activities  Activity[]
  tasks       Task[]
}

model Vendor {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills          PurchaseBill[]
  purchaseOrders PurchaseOrder[]
}

model Brand {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Category {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subCategories SubCategory[]
  products      Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

model SubCategory {
  id         String   @id @default(cuid())
  companyId  String   @map("orgId")
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products   Product[]

  @@unique([companyId, categoryId, name])
  @@index([companyId])
}

model StockLocation {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  code      String   // e.g., A6, Z1
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances  StockBalance[]
  ledger    StockLedger[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Product {
  id                 String   @id @default(cuid())
  companyId          String   @map("orgId")
  brandId            String
  brand              Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  sku                String
  normalizedSku      String
  title              String?
  name               String
  description        String?
  ratingType         String?  // Rating (kW)/ Type
  coo                String?  // Country of Origin
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryId      String?
  subCategory        SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  uom                String   @default("pcs")
  priceCents         Int      @default(0)
  unitCostMinor      Int?     @default(0)
  lowStockThreshold  Int?     // optional: warn when stock below this
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  invoiceLines       SalesInvoiceLine[]
  billLines          PurchaseBillLine[]
  quoteLines         QuoteLine[]
  purchaseOrderLines PurchaseOrderLine[]
  moves              InventoryMove[]
  balances           StockBalance[]
  ledger             StockLedger[]

  @@unique([companyId, brandId, normalizedSku])
  @@index([companyId, brandId])
  @@index([companyId, normalizedSku])
}

model SalesInvoice {
  id          String        @id @default(cuid())
  companyId   String   @map("orgId")
  number      String
  status      InvoiceStatus @default(DRAFT)
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceDate DateTime      @default(now())
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines              SalesInvoiceLine[]
  convertedFromQuote Quote?
  payments           Payment[]

  @@unique([companyId, number])
}

model Quote {
  id                    String      @id @default(cuid())
  companyId             String   @map("orgId")
  number                String
  status                QuoteStatus @default(DRAFT)
  customerId            String
  customer              Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quoteDate             DateTime    @default(now())
  validUntil            DateTime?
  notes                 String?
  convertedToInvoiceId  String?     @unique
  convertedToInvoice    SalesInvoice? @relation(fields: [convertedToInvoiceId], references: [id], onDelete: SetNull)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  lines                 QuoteLine[]

  @@unique([companyId, number])
}

model QuoteLine {
  id             String  @id @default(cuid())
  quoteId        String
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description   String
  qty           Int
  unitPriceCents Int
}

model SalesInvoiceLine {
  id          String       @id @default(cuid())
  invoiceId   String
  invoice     SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  qty         Int
  unitPriceCents Int
}

model PurchaseOrder {
  id        String              @id @default(cuid())
  companyId String   @map("orgId")
  number    String
  status    PurchaseOrderStatus  @default(DRAFT)
  vendorId  String
  vendor    Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orderDate DateTime            @default(now())
  expectedDate DateTime?
  notes     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  lines     PurchaseOrderLine[]

  @@unique([companyId, number])
}

model PurchaseOrderLine {
  id             String         @id @default(cuid())
  orderId        String
  order          PurchaseOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  description    String
  qtyOrdered     Int
  qtyReceived    Int             @default(0)
  unitPriceCents Int
}

model PurchaseBill {
  id        String      @id @default(cuid())
  companyId String   @map("orgId")
  number    String
  status    BillStatus  @default(DRAFT)
  vendorId  String
  vendor    Vendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  billDate  DateTime    @default(now())
  dueDate   DateTime?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  lines     PurchaseBillLine[]
  payments  Payment[]

  @@unique([companyId, number])
}

enum PaymentType {
  INBOUND
  OUTBOUND
}

enum PaymentMethod {
  CASH
  BANK
  CARD
  OTHER
}

model Payment {
  id           String        @id @default(cuid())
  companyId    String   @map("orgId")
  type         PaymentType
  amountCents  Int
  date         DateTime     @default(now())
  reference    String?
  method       PaymentMethod @default(CASH)
  invoiceId    String?
  invoice      SalesInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  billId       String?
  bill         PurchaseBill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())

  @@index([companyId, date])
  @@index([invoiceId])
  @@index([billId])
}

model OrgSetting {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  key       String
  value     String   // store JSON for complex values
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String   @map("orgId")
  userId     String
  action     String   // CREATED, UPDATED, DELETED
  entityType String
  entityId   String?
  oldValues  String?  // JSON
  newValues  String?  // JSON
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entityType])
}

model PurchaseBillLine {
  id          String       @id @default(cuid())
  billId      String
  bill        PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  qty         Int
  unitPriceCents Int
}

model InventoryMove {
  id        String            @id @default(cuid())
  companyId String   @map("orgId")
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type      InventoryMoveType
  qty       Int
  note      String?
  createdAt DateTime          @default(now())
}

model Account {
  id        String      @id @default(cuid())
  companyId String   @map("orgId")
  code      String
  name      String
  type      AccountType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  lines     JournalLine[]

  @@unique([companyId, code])
}

model JournalEntry {
  id        String      @id @default(cuid())
  companyId String   @map("orgId")
  date      DateTime    @default(now())
  memo      String?
  createdAt DateTime    @default(now())

  lines     JournalLine[]
}

model JournalLine {
  id         String       @id @default(cuid())
  entryId    String
  entry      JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debitCents Int          @default(0)
  creditCents Int         @default(0)
}

// CRM Models

model Contact {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String?
  email     String?
  phone     String?
  jobTitle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OpportunityStage {
  NEW
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Opportunity {
  id          String           @id @default(cuid())
  companyId   String   @map("orgId")
  title       String
  valueCents  Int              @default(0)
  stage       OpportunityStage @default(NEW)
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  closeDate   DateTime?
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  activities Activity[]
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

model Activity {
  id            String       @id @default(cuid())
  companyId     String   @map("orgId")
  type          ActivityType
  subject       String
  description   String?
  date          DateTime     @default(now())
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String       @id @default(cuid())
  companyId   String   @map("orgId")
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Inventory Models

model InventorySnapshot {
  id            String                 @id @default(cuid())
  companyId     String                 @map("orgId")
  importedAt    DateTime               @default(now())
  sourceFileName String
  sourceFileHash String
  mode          InventorySnapshotMode
  status        InventorySnapshotStatus
  warnings      Json?
  errors        Json?
  createdBy     String?
  createdAt     DateTime               @default(now())

  ledger        StockLedger[]

  @@unique([companyId, sourceFileHash])
  @@index([companyId, importedAt])
  @@index([companyId, status])
}

model StockBalance {
  id           String        @id @default(cuid())
  companyId    String        @map("orgId")
  itemId       String
  item         Product       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId   String?       // null = overall balance
  location     StockLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  qtyOnHand    Int           @default(0)
  avgCostMinor Int?
  updatedAt    DateTime      @updatedAt

  @@unique([companyId, itemId, locationId])
  @@index([companyId, itemId])
  @@index([companyId, locationId])
}

model StockLedger {
  id            String            @id @default(cuid())
  companyId     String            @map("orgId")
  itemId        String
  item          Product           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId    String?           // null = overall
  location      StockLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  txnType       StockLedgerTxnType
  qtyDelta      Int               // positive for IN, negative for OUT
  unitCostMinor Int?
  totalCostMinor Int?
  refInvoice    String?
  refChalan     String?
  notes         String?
  meta          Json?
  txnDate       DateTime          @default(now()) @db.Date
  snapshotId    String?           // link to import batch
  snapshot      InventorySnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  createdBy     String?           // userId if available
  createdAt     DateTime          @default(now())

  @@index([companyId, itemId, txnDate])
  @@index([companyId, locationId])
  @@index([companyId, snapshotId])
  @@index([companyId, txnDate])
}
