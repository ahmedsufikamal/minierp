model IamPermission {
  id          String              @id @default(cuid())
  key         String              @unique
  module      String
  description String?
  isSystem    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  roles IamRolePermission[]

  @@index([module])
}

model IamRole {
  id          String              @id @default(cuid())
  companyId   String              @map("orgId")
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean             @default(false)
  isDefault   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  permissions IamRolePermission[]
  memberships CompanyMembership[]
  invites     IamInvitation[]

  @@unique([companyId, name])
  @@index([companyId, isSystem])
}

model IamRolePermission {
  id           String        @id @default(cuid())
  roleId       String
  role         IamRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   IamPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model IamInvitation {
  id              String     @id @default(cuid())
  companyId       String     @map("orgId")
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email           String
  roleId          String?
  role            IamRole?   @relation(fields: [roleId], references: [id], onDelete: SetNull)
  tokenHash       String     @unique
  expiresAt       DateTime
  createdByUserId String?
  createdBy       User?      @relation("IamInviteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptedAt      DateTime?
  autoJoinRuleId  String?
  autoJoinRule    IamAutoJoinRule? @relation(fields: [autoJoinRuleId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([companyId, email])
  @@index([companyId, createdAt])
}

model IamAutoJoinRule {
  id         String              @id @default(cuid())
  companyId  String              @map("orgId")
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ruleType   IamAutoJoinRuleType
  config     Json
  isEnabled  Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  invites IamInvitation[]

  @@index([companyId, ruleType, isEnabled])
}

model IamSession {
  id               String                 @id @default(cuid())
  sessionTokenHash String                 @unique
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  impersonatorUserId String?
  rememberMe       Boolean                @default(false)
  userAgent        String?
  ip               String?
  requestId        String?
  createdAt        DateTime               @default(now())
  lastSeenAt       DateTime               @default(now())
  idleExpiresAt    DateTime
  expiresAt        DateTime
  stepUpVerifiedAt DateTime?
  revokedAt        DateTime?
  revokeReason     IamSessionRevokeReason?
  updatedAt        DateTime               @updatedAt

  impersonation IamImpersonationSession?

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
  @@index([expiresAt])
}

