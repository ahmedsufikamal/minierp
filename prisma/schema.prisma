  uploadedBy String?
  uploadedAt DateTime                      @default(now())
  scanStatus String                        @default("PENDING")
  metadata   Json?

  @@unique([companyId, storageKey])
  @@index([companyId, entityType, entityId])
}

model InventoryImportJob {
  id          String                   @id @default(cuid())
  companyId   String                   @map("orgId")
  entity      String
  status      InventoryImportJobStatus @default(PENDING)
  fileName    String
  storageKey  String?
  summary     Json?
  createdBy   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  rowErrors InventoryImportJobRowError[]

  @@index([companyId, status, createdAt])
}

model InventoryImportJobRowError {
  id        String             @id @default(cuid())
  jobId     String
  job       InventoryImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber Int
  field     String?
  message   String
  rawData   Json?
  createdAt DateTime           @default(now())

  @@index([jobId, rowNumber])
}

model InventoryExportJob {
  id          String                   @id @default(cuid())
  companyId   String                   @map("orgId")
  entity      String
  status      InventoryExportJobStatus @default(PENDING)
  format      String
  fileName    String
  filters     Json?
  outputKey   String?
  createdBy   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([companyId, status, createdAt])
}

model InventoryIdempotencyKey {
  id          String   @id @default(cuid())
  companyId   String   @map("orgId")
  scope       String
  key         String
  requestHash String?
  response    Json?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@unique([companyId, scope, key])
  @@index([companyId, createdAt])
}

model InventoryAuditLog {
  id          String   @id @default(cuid())
  companyId   String   @map("orgId")
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  diff        Json?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
}

model InventorySettingComment {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  userId    String
  comment   String
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, userId, createdAt])
}

model InventoryItemTag {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  itemId    String
  item      Product  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag       String
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([companyId, itemId, tag])
  @@index([companyId, tag])
  @@index([companyId, itemId])
}

model InventoryNotification {
  id        String    @id @default(cuid())
  companyId String    @map("orgId")
  type      String
  title     String
  message   String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId, readAt, createdAt])
}

model InventoryWebhookSubscription {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  eventType String
  endpoint  String
  secret    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, eventType, isActive])
}

model InventoryLabelTemplate {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  name      String
  paperType String
  widthMm   Float?
  heightMm  Float?
  isDefault Boolean  @default(false)
  config    Json
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, paperType, isDefault])
}

model IamPermission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles               IamRolePermission[]
  membershipOverrides CompanyMembershipPermission[]

  @@index([module])
}

model IamRole {
  id          String   @id @default(cuid())
  companyId   String   @map("orgId")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions IamRolePermission[]
  memberships CompanyMembership[]
  invites     IamInvitation[]

  @@unique([companyId, name])
  @@index([companyId, isSystem])
}

model IamRolePermission {
  id           String        @id @default(cuid())
  roleId       String
  role         IamRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   IamPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model CompanyMembershipPermission {
  id           String            @id @default(cuid())
  userId       String
  companyId    String
  permissionId String
  permission   IamPermission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  membership   CompanyMembership @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: Cascade)
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([userId, companyId, permissionId])
  @@index([companyId, userId])
  @@index([companyId, permissionId])
}

model IamInvitation {
  id              String           @id @default(cuid())
  companyId       String           @map("orgId")
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email           String
  roleId          String?
  role            IamRole?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  tokenHash       String           @unique
  expiresAt       DateTime
  createdByUserId String?
  createdBy       User?            @relation("IamInviteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptedAt      DateTime?
  autoJoinRuleId  String?
  autoJoinRule    IamAutoJoinRule? @relation(fields: [autoJoinRuleId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([companyId, email])
  @@index([companyId, createdAt])
}

model IamAutoJoinRule {
  id        String              @id @default(cuid())
  companyId String              @map("orgId")
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ruleType  IamAutoJoinRuleType
  config    Json
  isEnabled Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  invites IamInvitation[]

  @@index([companyId, ruleType, isEnabled])
}

model IamSession {
  id                 String                  @id @default(cuid())
  sessionTokenHash   String                  @unique
  userId             String
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId          String                  @map("orgId")
  company            Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  impersonatorUserId String?
  rememberMe         Boolean                 @default(false)
  userAgent          String?
  ip                 String?
  requestId          String?
  createdAt          DateTime                @default(now())
  lastSeenAt         DateTime                @default(now())
  idleExpiresAt      DateTime
  expiresAt          DateTime
  stepUpVerifiedAt   DateTime?
  revokedAt          DateTime?
  revokeReason       IamSessionRevokeReason?
  updatedAt          DateTime                @updatedAt

  impersonation IamImpersonationSession?

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
  @@index([expiresAt])
}

model IamMfaFactor {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        IamMfaFactorType
  label       String?
  secretEnc   String?
  destination String?
  isPrimary   Boolean          @default(false)
  isVerified  Boolean          @default(false)
  verifiedAt  DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  recoveryCodes IamRecoveryCode[]

  @@index([userId, type])
}

model IamRecoveryCode {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  factorId  String?
  factor    IamMfaFactor? @relation(fields: [factorId], references: [id], onDelete: SetNull)
  codeHash  String        @unique
  usedAt    DateTime?
  createdAt DateTime      @default(now())
}

model IamOtpChallenge {
  id          String        @id @default(cuid())
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  channel     IamOtpChannel
  destination String
  purpose     String
  codeHash    String
  attempts    Int           @default(0)
  maxAttempts Int           @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  requestId   String?
  ip          String?
  createdAt   DateTime      @default(now())

  @@index([destination, createdAt])
  @@index([companyId, createdAt])
}

model IamMagicLinkToken {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  purpose    String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  requestId  String?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model IamOAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId, provider])
}

model IamAuditLog {
  id          String         @id @default(cuid())
  companyId   String?        @map("orgId")
  company     Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actorUserId String?
  actor       User?          @relation("IamAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      IamAuditAction
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  ip          String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime       @default(now())

  @@index([companyId, createdAt])
  @@index([action, createdAt])
}

model IamLoginAttempt {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId  String?  @map("orgId")
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  email      String?
  result     String
  reasonCode String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([companyId, createdAt])
}

model IamImpersonationSession {
  id              String     @id @default(cuid())
  sessionId       String     @unique
  session         IamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actorUserId     String
  actorUser       User       @relation("IamImpersonationActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetUserId    String
  targetUser      User       @relation("IamImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetCompanyId String
  targetCompany   Company    @relation("IamImpersonationCompany", fields: [targetCompanyId], references: [id], onDelete: Cascade)
  reason          String
  startedAt       DateTime   @default(now())
  expiresAt       DateTime
  endedAt         DateTime?
}
