  action      IamAuditAction
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  ip          String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime       @default(now())

  @@index([companyId, createdAt])
  @@index([action, createdAt])
}

