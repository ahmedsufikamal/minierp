  paidToAccountId   String?
  paidToAccount     Account?              @relation("SupplierPaymentPaidTo", fields: [paidToAccountId], references: [id], onDelete: SetNull)
  paymentEntryId    String?
  paymentEntry      PaymentEntry?         @relation(fields: [paymentEntryId], references: [id], onDelete: SetNull)
  remarks           String?
  submittedAt       DateTime?
  postedAt          DateTime?
  cancelledAt       DateTime?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  allocations SupplierPaymentAllocation[]
  snapshots   PayableAgingSnapshot[]

  @@unique([companyId, number])
  @@index([companyId, status, paymentDate])
  @@index([companyId, vendorId, status])
  @@index([companyId, paymentEntryId])
  @@index([companyId, paidFromAccountId, paidToAccountId])
}

model SupplierPaymentAllocation {
  id                   String          @id @default(cuid())
  supplierPaymentId    String
  supplierPayment      SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  purchaseBillId       String?
  purchaseBill         PurchaseBill?   @relation(fields: [purchaseBillId], references: [id], onDelete: SetNull)
  allocatedAmountCents Int
  notes                String?
  createdAt            DateTime        @default(now())

  @@index([supplierPaymentId, purchaseBillId])
}

model PayableAgingSnapshot {
  id                    String           @id @default(cuid())
  tenantId              String?
  companyId             String           @map("orgId")
  vendorId              String
  vendor                Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  purchaseBillId        String?
  purchaseBill          PurchaseBill?    @relation(fields: [purchaseBillId], references: [id], onDelete: SetNull)
  supplierPaymentId     String?
  supplierPayment       SupplierPayment? @relation(fields: [supplierPaymentId], references: [id], onDelete: SetNull)
  asOfDate              DateTime         @db.Date
  currency              String           @default("USD")
  bucketCurrentCents    Int              @default(0)
  bucket1To30Cents      Int              @default(0)
  bucket31To60Cents     Int              @default(0)
  bucket61To90Cents     Int              @default(0)
  bucketOver90Cents     Int              @default(0)
  totalOutstandingCents Int              @default(0)
  createdBy             String?
  createdAt             DateTime         @default(now())

  @@index([companyId, asOfDate, vendorId])
  @@index([companyId, purchaseBillId, asOfDate])
}

