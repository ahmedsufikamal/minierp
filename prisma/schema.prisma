model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  passwordHash          String
  name                  String
  role                  String          @default("USER")
  companyId             String          @default("default-org") @map("orgId")
  phone                 String?
  phoneVerifiedAt       DateTime?
  avatarUrl             String?
  emailVerifiedAt       DateTime?
  pendingEmail          String?
  pendingEmailExpiresAt DateTime?
  uiThemePreference     ThemeMode       @default(SYSTEM)
  mustResetPassword     Boolean         @default(false)
  platformRole          IamPlatformRole @default(NONE)
  status                IamUserStatus   @default(ACTIVE)
  activeCompanyId       String?         @map("activeOrgId")
  sessionVersion        Int             @default(1)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  activeCompany       Company?                  @relation("ActiveCompany", fields: [activeCompanyId], references: [id], onDelete: SetNull)
  memberships         CompanyMembership[]
  iamSessions         IamSession[]
  iamMfaFactors       IamMfaFactor[]
  iamRecoveryCodes    IamRecoveryCode[]
  iamOtpChallenges    IamOtpChallenge[]
  iamMagicLinkTokens  IamMagicLinkToken[]
  iamOAuthAccounts    IamOAuthAccount[]
  iamInvitesCreated   IamInvitation[]           @relation("IamInviteCreator")
  iamAuditActorEvents IamAuditLog[]             @relation("IamAuditActor")
  iamLoginAttempts    IamLoginAttempt[]
  iamImpersonations   IamImpersonationSession[] @relation("IamImpersonationActor")
  iamImpersonatedBy   IamImpersonationSession[] @relation("IamImpersonationTarget")
  tenantMemberships   TenantMembership[]
}

model Customer {
  id              String              @id @default(cuid())
  companyId       String              @map("orgId")
  territoryId     String?
  territory       SetupTerritory?     @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  customerGroupId String?
  customerGroup   SetupCustomerGroup? @relation(fields: [customerGroupId], references: [id], onDelete: SetNull)
  name            String
  email           String?
  phone           String?
  address         String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  invoices                 SalesInvoice[]
  quotes                   Quote[]
  salesOrders              SalesOrder[]
  deliveryNotes            DeliveryNote[]
  contacts                 Contact[]
  opportunities            Opportunity[]
  activities               Activity[]
  tasks                    Task[]
  convertedLeads           Lead[]                    @relation("CustomerConvertedLeads")
  projects                 Project[]
  tickets                  Ticket[]
  communications           CommunicationLog[]
  calls                    CallLog[]
  posSales                 PosSale[]
  dunningNotices           DunningNotice[]
  receivableAgingSnapshots ReceivableAgingSnapshot[]

  @@index([companyId, territoryId])
  @@index([companyId, customerGroupId])
}

model Vendor {
  id              String              @id @default(cuid())
  companyId       String              @map("orgId")
  territoryId     String?
  territory       SetupTerritory?     @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  supplierGroupId String?
  supplierGroup   SetupSupplierGroup? @relation(fields: [supplierGroupId], references: [id], onDelete: SetNull)
  name            String
  email           String?
  phone           String?
  address         String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  bills                      PurchaseBill[]
  purchaseOrders             PurchaseOrder[]
  supplierQuotations         SupplierQuotation[]
  requestForQuotationVendors RequestForQuotationVendor[]
  purchaseReceipts           PurchaseReceipt[]
  materialRequests           MaterialRequestLine[]
  reorderRules               InventoryReorderRule[]
  subcontractingOrders       SubcontractingOrder[]
  subcontractingReceipts     SubcontractingReceipt[]
  supplierPayments           SupplierPayment[]
  payableAgingSnapshots      PayableAgingSnapshot[]
  tradeLcs                   TradeLc[]

  @@index([companyId, territoryId])
  @@index([companyId, supplierGroupId])
}

model Brand {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Category {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subCategories SubCategory[]
  products      Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

model SubCategory {
  id         String   @id @default(cuid())
  companyId  String   @map("orgId")
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products Product[]

  @@unique([companyId, categoryId, name])
  @@index([companyId])
}

model SetupItemGroup {
  id        String           @id @default(cuid())
  tenantId  String
  companyId String           @map("orgId")
  parentId  String?
  parent    SetupItemGroup?  @relation("SetupItemGroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  SetupItemGroup[] @relation("SetupItemGroupTree")
  name      String
  isGroup   Boolean          @default(false)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  products Product[]

  @@unique([tenantId, companyId, name])
  @@index([tenantId, companyId, parentId])
}

model SetupUom {
  id                String   @id @default(cuid())
  tenantId          String
  companyId         String   @map("orgId")
  name              String
  symbol            String?
  mustBeWholeNumber Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  products        Product[]                  @relation("ProductUom")
  fromConversions SetupUomConversionFactor[] @relation("SetupUomConversionFrom")
  toConversions   SetupUomConversionFactor[] @relation("SetupUomConversionTo")

  @@unique([tenantId, companyId, name])
  @@index([tenantId, companyId, isActive])
}

model SetupUomConversionFactor {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String   @map("orgId")
  fromUomId String
  fromUom   SetupUom @relation("SetupUomConversionFrom", fields: [fromUomId], references: [id], onDelete: Cascade)
  toUomId   String
  toUom     SetupUom @relation("SetupUomConversionTo", fields: [toUomId], references: [id], onDelete: Cascade)
  factor    Decimal  @db.Decimal(18, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, companyId, fromUomId, toUomId])
  @@index([tenantId, companyId, fromUomId])
}

model SetupTerritory {
  id        String           @id @default(cuid())
  tenantId  String
  companyId String           @map("orgId")
  parentId  String?
  parent    SetupTerritory?  @relation("SetupTerritoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  SetupTerritory[] @relation("SetupTerritoryTree")
  name      String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  customers Customer[]
  vendors   Vendor[]

  @@unique([tenantId, companyId, name])
  @@index([tenantId, companyId, parentId])
}

model SetupCustomerGroup {
  id        String               @id @default(cuid())
  tenantId  String
  companyId String               @map("orgId")
  parentId  String?
  parent    SetupCustomerGroup?  @relation("SetupCustomerGroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  SetupCustomerGroup[] @relation("SetupCustomerGroupTree")
  name      String
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  customers Customer[]

  @@unique([tenantId, companyId, name])
  @@index([tenantId, companyId, parentId])
}

model SetupSupplierGroup {
  id        String               @id @default(cuid())
  tenantId  String
  companyId String               @map("orgId")
  parentId  String?
  parent    SetupSupplierGroup?  @relation("SetupSupplierGroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  SetupSupplierGroup[] @relation("SetupSupplierGroupTree")
  name      String
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  vendors Vendor[]

  @@unique([tenantId, companyId, name])
  @@index([tenantId, companyId, parentId])
}

model SetupBranch {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String   @map("orgId")
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, companyId, name])
  @@index([tenantId, companyId, isActive])
}

model SetupDepartment {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String   @map("orgId")
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@unique([tenantId, companyId, name])
  @@index([tenantId, companyId, isActive])
}

model SetupDesignation {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String   @map("orgId")
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@unique([tenantId, companyId, name])
  @@index([tenantId, companyId, isActive])
}

model StockLocation {
  id        String   @id @default(cuid())
  companyId String   @map("orgId")
  code      String // e.g., A6, Z1
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances StockBalance[]
  ledger   StockLedger[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Product {
  id                String          @id @default(cuid())
  companyId         String          @map("orgId")
  brandId           String
  brand             Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  sku               String
  normalizedSku     String
  barcode           String?
  title             String?
  name              String
  description       String?
  ratingType        String? // Rating (kW)/ Type
  coo               String? // Country of Origin
  categoryId        String?
  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryId     String?
  subCategory       SubCategory?    @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  itemGroupId       String?
  itemGroup         SetupItemGroup? @relation(fields: [itemGroupId], references: [id], onDelete: SetNull)
  uomId             String?
  uomRef            SetupUom?       @relation("ProductUom", fields: [uomId], references: [id], onDelete: SetNull)
  uom               String          @default("pcs")
  priceCents        Int             @default(0)
  unitCostMinor     Int?            @default(0)
  trackSerial       Boolean         @default(false)
  trackBatch        Boolean         @default(false)
  lowStockThreshold Int? // optional: warn when stock below this
  assignedTo        String?
  createdBy         String?
  itemType          String?
  itemStatus        String?
  customData        Json?
  isTemplate        Boolean         @default(false)
  variantOfId       String?
  variantOf         Product?        @relation("ProductVariants", fields: [variantOfId], references: [id], onDelete: SetNull)
  variants          Product[]       @relation("ProductVariants")
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  invoiceLines               SalesInvoiceLine[]
  billLines                  PurchaseBillLine[]
  quoteLines                 QuoteLine[]
  salesOrderLines            SalesOrderLine[]
  deliveryNoteLines          DeliveryNoteLine[]
  purchaseOrderLines         PurchaseOrderLine[]
  materialRequestLines       MaterialRequestLine[]
  requestForQuotationLines   RequestForQuotationLine[]
  supplierQuotationLines     SupplierQuotationLine[]
  purchaseReceiptLines       PurchaseReceiptLine[]
  bomHeaders                 Bom[]
  bomLines                   BomLine[]
  workOrders                 WorkOrder[]
  subcontractingOrderItems   SubcontractingOrderItem[]
  subcontractingReceiptItems SubcontractingReceiptItem[]
  qualityInspections         QualityInspection[]
  posSaleLines               PosSaleLine[]
  moves                      InventoryMove[]
  balances                   StockBalance[]
  ledger                     StockLedger[]
  inventoryItemIdentifiers   InventoryItemIdentifier[]
  inventoryTags              InventoryItemTag[]
  inventoryDocumentLines     InventoryDocumentLine[]
  inventoryLedgerEntries     InventoryLedgerEntry[]
  inventoryStockBalances     InventoryStockBalance[]
  inventoryReorderRules      InventoryReorderRule[]
  inventoryReservations      InventoryReservation[]
  inventoryBatches           InventoryBatch[]
  inventorySerials           InventorySerial[]
  inventoryStockClosingLines InventoryStockClosingLine[]

  @@unique([companyId, brandId, normalizedSku])
  @@index([companyId, brandId])
  @@index([companyId, normalizedSku])
  @@index([companyId, itemGroupId])
  @@index([companyId, uomId])
  @@index([companyId, updatedAt])
  @@index([companyId, assignedTo])
  @@index([companyId, createdBy])
  @@index([companyId, barcode])
  @@index([companyId, variantOfId])
  @@index([companyId, isActive, isTemplate])
}

model SalesInvoice {
  id          String        @id @default(cuid())
  companyId   String        @map("orgId")
  number      String
  status      InvoiceStatus @default(DRAFT)
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceDate DateTime      @default(now())
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines                    SalesInvoiceLine[]
  convertedFromQuote       Quote?
  payments                 Payment[]
  timesheets               Timesheet[]
  posSale                  PosSale?
  dunningNotices           DunningNotice[]
  receivableAgingSnapshots ReceivableAgingSnapshot[]
  projectBillingEntries    ProjectBillingEntry[]

  @@unique([companyId, number])
}

model Quote {
  id                   String        @id @default(cuid())
  companyId            String        @map("orgId")
  number               String
  status               QuoteStatus   @default(DRAFT)
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quoteDate            DateTime      @default(now())
  validUntil           DateTime?
  notes                String?
  convertedToInvoiceId String?       @unique
  convertedToInvoice   SalesInvoice? @relation(fields: [convertedToInvoiceId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  lines       QuoteLine[]
  salesOrders SalesOrder[]

  @@unique([companyId, number])
}

model QuoteLine {
  id             String   @id @default(cuid())
  quoteId        String
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description    String
  qty            Int
  unitPriceCents Int

  salesOrderLines SalesOrderLine[]
}

model SalesOrder {
  id                     String                      @id @default(cuid())
  tenantId               String?
  companyId              String                      @map("orgId")
