  @@index([userId, type])
}

model IamRecoveryCode {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  factorId  String?
  factor    IamMfaFactor? @relation(fields: [factorId], references: [id], onDelete: SetNull)
  codeHash  String        @unique
  usedAt    DateTime?
  createdAt DateTime      @default(now())
}

model IamOtpChallenge {
