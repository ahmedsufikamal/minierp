  scope       InventoryPresetScope @default(USER)
  ownerUserId String?
  role        String?
  isDefault   Boolean              @default(false)
  config      Json
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([companyId, entity, scope, ownerUserId])
  @@index([companyId, entity, scope, role])
}

model InventoryWorkflowDefinition {
  id           String                @id @default(cuid())
  companyId    String                @map("orgId")
  documentType InventoryDocumentType
  name         String
  version      Int                   @default(1)
  isActive     Boolean               @default(true)
  config       Json
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([companyId, documentType, isActive])
}

model InventoryDocument {
  id                     String                      @id @default(cuid())
  companyId              String                      @map("orgId")
  documentType           InventoryDocumentType
  number                 String
  status                 InventoryDocumentStatus     @default(DRAFT)
  sourceWarehouseId      String?
  sourceWarehouse        InventoryWarehouse?         @relation("InventoryDocumentSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)
  sourceLocationId       String?
  sourceLocation         InventoryWarehouseLocation? @relation("InventoryDocumentSourceLocation", fields: [sourceLocationId], references: [id], onDelete: SetNull)
  destinationWarehouseId String?
  destinationWarehouse   InventoryWarehouse?         @relation("InventoryDocumentDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  destinationLocationId  String?
  destinationLocation    InventoryWarehouseLocation? @relation("InventoryDocumentDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  workflowState          Json?
  documentDate           DateTime                    @default(now()) @db.Date
  externalRef            String?
  notes                  String?
  metadata               Json?
  submittedAt            DateTime?
  submittedBy            String?
  approvedAt             DateTime?
  approvedBy             String?
  rejectedAt             DateTime?
  rejectedBy             String?
  cancelledAt            DateTime?
  cancelledBy            String?
  postedAt               DateTime?
  postedBy               String?
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  lines         InventoryDocumentLine[]
  workflow      InventoryWorkflowState?
  ledgerEntries InventoryLedgerEntry[]

  @@unique([companyId, number])
  @@index([companyId, documentType, status, createdAt])
}

model InventoryDocumentLine {
  id                     String                      @id @default(cuid())
  companyId              String                      @map("orgId")
  documentId             String
  document               InventoryDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lineNo                 Int
  itemId                 String
  item                   Product                     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  description            String?
  quantity               Int
  unitCostMinor          Int?
  currency               String                      @default("BDT")
  sourceWarehouseId      String?
  sourceWarehouse        InventoryWarehouse?         @relation("InventoryDocumentLineSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)
  sourceLocationId       String?
  sourceLocation         InventoryWarehouseLocation? @relation("InventoryDocumentLineSourceLocation", fields: [sourceLocationId], references: [id], onDelete: SetNull)
  destinationWarehouseId String?
  destinationWarehouse   InventoryWarehouse?         @relation("InventoryDocumentLineDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  destinationLocationId  String?
  destinationLocation    InventoryWarehouseLocation? @relation("InventoryDocumentLineDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  customData             Json?
  metadata               Json?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  ledgerEntries InventoryLedgerEntry[]

  @@index([companyId, documentId])
  @@index([companyId, itemId])
}

model InventoryWorkflowState {
  id            String                  @id @default(cuid())
  companyId     String                  @map("orgId")
  documentId    String                  @unique
  document      InventoryDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  currentStatus InventoryDocumentStatus
  steps         Json
  lastAction    String?
  lastActionBy  String?
  lastActionAt  DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([companyId, currentStatus])
}

model InventoryLedgerEntry {
  id             String                      @id @default(cuid())
  companyId      String                      @map("orgId")
  documentId     String?
  document       InventoryDocument?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentLineId String?
  documentLine   InventoryDocumentLine?      @relation(fields: [documentLineId], references: [id], onDelete: SetNull)
  itemId         String
  item           Product                     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      InventoryWarehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locationId     String?
  location       InventoryWarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  quantityDelta  Int
  unitCostMinor  Int?
  totalCostMinor Int?
  currency       String                      @default("BDT")
  postingTime    DateTime                    @default(now())
  metadata       Json?
  createdBy      String?
  createdAt      DateTime                    @default(now())

  @@index([companyId, itemId, postingTime])
  @@index([companyId, warehouseId, locationId])
  @@index([companyId, documentId])
}

model InventoryStockBalance {
  id           String                      @id @default(cuid())
  companyId    String                      @map("orgId")
  itemId       String
  item         Product                     @relation(fields: [itemId], references: [id], onDelete: Cascade)
