{
  "name": "minierp-clerk-nextjs",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5432/minierp} next build",
    "start": "next start -p 3000",
    "postinstall": "npm run prisma:generate",
    "lint": "eslint src --max-warnings=0 && npm run theme:audit",
    "format": "prettier --write \"{src,prisma,docs,e2e,scripts}/**/*.{ts,tsx,js,mjs,json,md,sql}\"",
    "format:check": "prettier --check \"{src,prisma,docs,e2e,scripts}/**/*.{ts,tsx,js,mjs,json,md,sql}\"",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.e2e.test.ts'",
    "test:integration": "vitest run --no-file-parallelism $(find src -name '*.integration.test.ts' -print)",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --config=playwright.smoke.config.ts tests/e2e/smoke",
    "test:e2e:legacy": "vitest run src/modules/inventory/application/__tests__/posting-flow.e2e.test.ts",
    "test:run": "vitest run",
    "parity:status": "node scripts/parity-status.mjs",
    "theme:audit": "node scripts/theme-audit.mjs",
    "tenancy:audit": "node scripts/tenancy-scope-audit.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.mjs",
    "iam:backfill": "node scripts/iam-backfill.mjs",
    "iam:master-admin:backfill": "node scripts/iam-master-admin-backfill.mjs",
    "iam:worker": "node scripts/iam-worker.mjs",
    "inventory:seed": "node prisma/seed.mjs",
    "typecheck": "tsc -p tsconfig.refactor.json --noEmit",
    "typecheck:full": "tsc -p tsconfig.fullcheck.json --noEmit",
    "check": "bash scripts/check.sh",
    "deps:outdated": "npm outdated",
    "deps:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.21",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.68.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "17.2.3",
    "jose": "^6.1.3",
    "lucide-react": "^0.562.0",
    "next": "16.1.4",
    "next-themes": "^0.4.6",
    "pg": "8.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "25.0.10",
    "@types/pg": "^8.6.6",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.23",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.4",
    "postcss": "8.5.6",
    "prettier": "3.8.1",
    "prisma": "^6.19.2",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^2.1.9"
  }
}
